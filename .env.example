# Copy to .env. Never commit .env.
# The values below are local development defaults for docker-compose.yml.
DATABASE_URL=postgresql://shirt:shirt@localhost:5433/shirt
REDIS_URL=redis://localhost:6379

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stand-in login only. Change it if the app ever leaves your machine.
AUTH_JWT_SECRET=dev-only-secret-change-me

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=shirt-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Image API: fake costs nothing, nano-banana calls Google and needs GEMINI_API_KEY.
IMAGE_PROVIDER=fake
# Gemini key from Google AI Studio, with billing on.
GEMINI_API_KEY=

# Telegram bot. Only one running copy per token can listen at a time.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
